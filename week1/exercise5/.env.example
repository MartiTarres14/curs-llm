# Copy to .env and edit. .env is git-ignored and must never be committed.

# --- LLM endpoint (OpenAI-compatible) ---
# Ollama on the host, seen from inside the container:
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Running the backend outside Docker? Use http://localhost:11434/v1 instead.
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=qwen2.5:3b

# Optional. Leave empty to disable image attachments in the UI.
LLM_VISION_MODEL=

# --- App ---
# Host port to publish. Any 666n port; visit http://localhost:<APP_PORT>
APP_PORT=6661
SYSTEM_PROMPT=You are a helpful assistant.
# How many of the most recent turns are forwarded upstream.
MAX_HISTORY_MESSAGES=20
