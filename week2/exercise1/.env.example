# Copy to .env and edit. .env is git-ignored and must never be committed.

# --- LLM endpoint (OpenAI-compatible) ---
# This is the model your ASSISTANT talks to — not the one that writes your code.
# A small local model is fine here.
#
#   ollama serve
#   ollama pull qwen2.5:3b
#
# Pick a model without a "thinking" mode. qwen3:1.7b also works, but it spends
# a long time reasoning out loud before every answer, and with a whole document
# in the prompt that wait gets tedious fast.
#
# Ollama on the host, seen from inside the container:
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Running the backend outside Docker? Use http://localhost:11434/v1 instead.
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=qwen2.5:3b

# Want stronger answers? Point these three at a frontier endpoint instead.
# No code changes — that is the whole point.

# --- App ---
# Host port to publish. Visit http://localhost:<APP_PORT>
APP_PORT=6662

# Where assistants.json and the uploaded documents live. Leave empty for
# ./data next to this file; docker compose mounts that same folder.
DATA_DIR=

# How many earlier turns are forwarded upstream. 0 disables history, which
# makes every question independent.
MAX_HISTORY_MESSAGES=20
