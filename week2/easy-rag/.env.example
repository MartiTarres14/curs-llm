# Copy to .env and edit. .env is git-ignored and must never be committed.

# --- LLM endpoint (OpenAI-compatible) ---
# The model that WRITES THE ANSWERS — not the one that writes your code.
#
#   ollama serve
#   ollama pull qwen3:1.7b
#
# Ollama on the host, seen from inside the container:
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Running the backend outside Docker? Use http://localhost:11434/v1 instead.
LLM_API_KEY=not-needed-for-ollama
LLM_MODEL=qwen3:1.7b

# --- Embeddings endpoint (read by collections-manager) ---
# The model that TURNS TEXT INTO VECTORS. Everything in a collection must be
# embedded by the same model, or the geometry means nothing.
#
#   ollama pull nomic-embed-text
#
OPENAI_ENDPOINT=http://host.docker.internal:11434/v1
OPENAI_API_KEY=not-needed-for-ollama
EMBED_MODEL=nomic-embed-text

# --- The retrieval gate (configuration, not constants) ---
# How many nearest chunks to consider per question…
RAG_TOP_K=4
# …and how similar a chunk must be to reach the prompt. This value is a
# CALIBRATION against your embeddings model and your documents, not a truth:
# with nomic-embed-text, off-topic questions score ~0.40-0.55 (not near zero!)
# and real answers ~0.55-0.70. Watch the retrieval panel and adjust.
RAG_THRESHOLD=0.57

# --- Ingestion / chunking ---
# "sections" cuts at the document's own headings (SECTION_LEVEL=2 cuts at ##)
# and falls back to "chars" when a document converts without headings.
# "chars" is a sliding window: CHUNK_SIZE characters, CHUNK_OVERLAP shared.
CHUNK_STRATEGY=sections
SECTION_LEVEL=2
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- App ---
# Host port to publish. Visit http://localhost:<APP_PORT>
APP_PORT=6663

# Where assistants.json, the ingested files and the collections live. Leave
# empty for ./data next to this file; docker compose mounts that same folder.
DATA_DIR=

# How many earlier turns are forwarded upstream. 0 disables history, which
# makes every question independent.
MAX_HISTORY_MESSAGES=20
